Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else through index.php
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Block access to sensitive files at root level
<FilesMatch "\.(env|log|lock|json|neon|xml|md)$">
    Require all denied
</FilesMatch>

# Allow composer.json and package.json to be blocked but not src/ contents
<FilesMatch "^(composer\.(json|lock)|package\.json|package-lock\.json)$">
    Require all denied
</FilesMatch>
